{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist-sdk",
    "rootDir": "src",
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["src/sdk/**/*.ts", "src/lib/address.ts", "src/lib/networks.ts", "src/lib/paymentIntent.ts"]
}
