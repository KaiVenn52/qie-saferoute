{
  "name": "qie-saferoute-sdk",
  "private": false,
  "version": "0.1.0",
  "description": "QIE dual-address and signed payment intent preflight SDK",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist-sdk",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist-sdk/sdk/index.d.ts",
      "import": "./dist-sdk/sdk/index.js"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && npm run build:sdk",
    "build:sdk": "tsc -p tsconfig.sdk.json",
    "contracts:compile": "hardhat compile --build-profile production",
    "contracts:test": "hardhat test nodejs test/PaymentIntentRegistry.ts --build-profile production",
    "contracts:deploy:local": "hardhat run --network hardhatMainnet --build-profile production scripts/deploy-registry.ts",
    "contracts:deploy:testnet": "hardhat run --network qieTestnet --build-profile production scripts/deploy-registry.ts",
    "contracts:deploy:mainnet": "hardhat run --network qieMainnet --build-profile production scripts/deploy-registry.ts",
    "lint": "oxlint",
    "test": "vitest run",
    "validate": "npm run lint && npm test && npm run contracts:test && npm run build && npm pack --dry-run",
    "preview": "vite preview"
  },
  "dependencies": {
    "bech32": "^2.0.0",
    "lucide-react": "^1.31.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "viem": "^2.55.11"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-node-test-runner": "^3.1.0",
    "@nomicfoundation/hardhat-viem": "^3.0.9",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "hardhat": "^3.15.0",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
